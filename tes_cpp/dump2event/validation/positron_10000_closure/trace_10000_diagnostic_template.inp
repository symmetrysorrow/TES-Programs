$OMP=1
[ T i t l e ]
minimized input file for lecture

[ P a r a m e t e r s ]
icntl = 0
maxcas = 10000
maxbch = 1
bitrseed = 0101101011001010010111000011100101101001110000111011001010010111
file(6) = phits.out
negs  =  1
e-mode  =  2
dumpall = -1
file(15) = dumpall.dat
iegsrand = 1
emin(12)=0.001
emin(13)=0.001
emin(14)=0.001
#iedgfl = 0
#iauger = 0
#iraylr = 0

[ S o u r c e ]
totfact = 1.0
s-type =   1
proj =  photon
dir =   -1.0
x0 = -90/101
r0 =   0.0
z0 =   1.0
z1 =   1.1
e-type = 8
ne = 2
1.173	1
1.332	1
#e0 =   1.332



[ M a t e r i a l ]
mat[1]     Cu 1
mat[2]     Pb 1
mat[3]     Bi 1
mat[4] N 0.78084  O 0.20946  Ar 0.00934  # air


[ Mat Name Color ]
mat   name      color
1    copper      orange
2    lead         pastelblue
3    bismuth     red
4    air               blue

[ S u r f a c e ]
100  rpp   -1.0 1.0  -0.05  0.05  -0.1 0.0
200  rpp    -10 10 -10 10 -10 10

[ C e l l ]
1000    2   -9.78   -100
2000    0   -200    #1000
9999    -1      200

[t-gshow]
mesh = xyz
x-type = 2
nx = 300
xmin = -2
xmax =  2
y-type = 2
ny = 1
ymin = -1
ymax =  1
z-type = 2
nz = 300
zmin = -1.0
zmax =  2.0
axis = xz
output = 6
file = gshow.out
epsout = 1


[counter] off
counter = 1
part = photon
reg in out coll ref
1000 1 0 1 0

[ T - T r a c k ]
title = Track Detection in xyz mesh
mesh =  xyz            # mesh type is xyz scoring mesh
x-type =    2            # x-mesh is linear given by xmin, xmax and nx
nx =   300            # number of x-mesh points
xmin =  -2           # minimum value of x-mesh points
xmax =   2          # maximum value of x-mesh points
y-type =    2            # y-mesh is linear given by ymin, ymax and ny
ny =   1            # number of y-mesh points
ymin =  -0.05           # minimum value of y-mesh points
ymax =   0.05           # maximum value of y-mesh points
z-type = 2
nz = 300
zmin = -1
zmax =  1.5
e-type = 2
ne = 1
emin = 0.0
emax = 1.5

#ctmin(1) = 1

unit =    1            # unit is [1/cm^2/source]
axis =   xz            # axis of output
file = track_xy.out  # file name of output for the above axis
part =  all
gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
epsout =    1            # (D=0) generate eps file by ANGEL


[t-deposit]
mesh = reg
reg = 1000
part = all
deposit = 0
unit = 3
output = deposit
e-type = 2
ne = 150
emin = 0.0
emax = 1.5
axis = eng
file = tdeposit_history.out


\r\n