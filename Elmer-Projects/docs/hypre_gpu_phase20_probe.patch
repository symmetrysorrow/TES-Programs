+  REAL(KIND=dp) FUNCTION BlockProbeNow()
+    INTEGER :: count, rate, count_max
+    INTEGER(KIND=8) :: delta, modulus
+    CALL SYSTEM_CLOCK(count, rate, count_max)
+    IF( rate <= 0 ) THEN
+      BlockProbeNow = 0.0_dp
+    ELSE IF( .NOT. BlockProbeClockInitialized .OR. &
+        BlockProbeClockLastRate /= rate ) THEN
+      BlockProbeClockInitialized = .TRUE.
+      BlockProbeClockLastCount = count
+      BlockProbeClockLastRate = rate
+      BlockProbeClockTicks = 0_8
+      BlockProbeNow = 0.0_dp
+    ELSE
+      delta = INT(count,KIND=8) - INT(BlockProbeClockLastCount,KIND=8)
+      IF( delta < 0 ) THEN
+        modulus = INT(count_max,KIND=8) + 1_8
+        IF( modulus > 0_8 ) delta = delta + modulus
+      END IF
+      IF( delta < 0 ) delta = 0_8
+      BlockProbeClockTicks = BlockProbeClockTicks + delta
+      BlockProbeClockLastCount = count
+      BlockProbeNow = REAL(BlockProbeClockTicks,dp) / REAL(rate,dp)
+    END IF
+  END FUNCTION BlockProbeNow
+
+  SUBROUTINE BlockSchurProbeInitialize( Prefix )
