+          BlockProbeKPrimal-PrimalBefore,',',BlockProbeKSchur-SchurKBefore,',', &
+          BlockProbeKUpper-UpperBefore,',',BlockProbeKSetup-SetupBefore,',', &
+          BlockProbeKSeconds,',',elapsed,',',BlockProbeKSeconds,',', &
+          BlockProbeKSchurSeconds,',','missing',',','missing',',','missing',',','missing'
+      IF( ios /= 0 ) THEN
+        CALL Warn('BlockSchurProbe','cannot write outer CSV row, IOSTAT='//I2S(ios))
+      END IF
+      CLOSE(unit)
+    ELSE
+      CALL Warn('BlockSchurProbe','cannot append outer CSV')
+    END IF
+  END SUBROUTINE BlockSchurProbeWriteOuter
