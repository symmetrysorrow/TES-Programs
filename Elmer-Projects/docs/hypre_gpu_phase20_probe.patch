+  REAL(KIND=dp) FUNCTION BlockProbeNow()
+    INTEGER :: count, rate, count_max
+    CALL SYSTEM_CLOCK(count, rate, count_max)
+    IF( rate <= 0 ) THEN
+      BlockProbeNow = 0.0_dp
+    ELSE
+      BlockProbeNow = REAL(count,dp) / REAL(rate,dp)
+    END IF
+  END FUNCTION BlockProbeNow
