+          BlockProbeKPrimal-PrimalBefore,',', &
+          BlockProbeKSchur-SchurKBefore,',', &
+          BlockProbeKUpper-UpperBefore,',',BlockProbeKSetup-SetupBefore,',', &
+          BlockProbeKSeconds,',',elapsed,',', &
+          BlockProbeKSeconds,',',BlockProbeKSchurSeconds,',', &
+          'missing',',','missing',',','missing',',','missing'
