+    CALL block_schur_superlu_solve(n,nnz,A % Values,A % Cols,A % Rows,Sol,InfoCode)
+    IF( InfoCode /= 0 ) CALL Fatal('BlockSchurSuperLUSolve', &
+        'SuperLU failed with info='//I2S(InfoCode))
+  END SUBROUTINE BlockSchurSuperLUSolve
