+  !------------------------------------------------------------------------------
+  !> Apply S = D - B K^-1 B^T without constructing S.
+  !------------------------------------------------------------------------------
+  SUBROUTINE BlockSchurAction( v, y, KSolver, KVar )
+    REAL(KIND=dp), INTENT(in) :: v(:)
+    REAL(KIND=dp), INTENT(out) :: y(:)
+    TYPE(Solver_t), POINTER :: KSolver
+    TYPE(Variable_t), POINTER :: KVar
+    TYPE(Matrix_t), POINTER :: K, B, Bt, D
+    REAL(KIND=dp), ALLOCATABLE :: bt_v(:), k_u(:), b_k_u(:), d_v(:)
+    INTEGER :: nu,nc
+
+    K => TotMatrix % Submatrix(1,1) % Mat
+    B => TotMatrix % Submatrix(2,1) % Mat
+    Bt => TotMatrix % Submatrix(1,2) % Mat
+    D => TotMatrix % Submatrix(2,2) % Mat
+    nu = K % NumberOfRows
+    nc = B % NumberOfRows
+    IF( SIZE(v) /= nc .OR. SIZE(y) /= nc ) CALL Fatal('BlockSchurAction', &
+        'Incompatible Schur vector size')
+    ALLOCATE(bt_v(nu), k_u(nu), b_k_u(nc), d_v(nc))
+
+    CALL BlockSchurActionWork(v,y,KSolver,KVar,bt_v,k_u,b_k_u,d_v)
+    DEALLOCATE(bt_v,k_u,b_k_u,d_v)
+  END SUBROUTINE BlockSchurAction
+
+
+  ! Work-array form used by the inner Krylov solver.  Keeping these arrays
+  ! outside the matvec loop avoids allocator traffic for every Schur action.
+  SUBROUTINE BlockSchurActionWork( v, y, KSolver, KVar, bt_v, k_u, &
+      b_k_u, d_v )
+    REAL(KIND=dp), INTENT(in) :: v(:)
+    REAL(KIND=dp), INTENT(out) :: y(:)
+    TYPE(Solver_t), POINTER :: KSolver
+    TYPE(Variable_t), POINTER :: KVar
+    REAL(KIND=dp), INTENT(out) :: bt_v(:), k_u(:), b_k_u(:), d_v(:)
+    TYPE(Matrix_t), POINTER :: K, B, Bt, D
+    INTEGER :: nu,nc
+
+    K => TotMatrix % Submatrix(1,1) % Mat
+    B => TotMatrix % Submatrix(2,1) % Mat
+    Bt => TotMatrix % Submatrix(1,2) % Mat
+    D => TotMatrix % Submatrix(2,2) % Mat
+    nu = K % NumberOfRows
+    nc = B % NumberOfRows
+    IF( SIZE(v) /= nc .OR. SIZE(y) /= nc .OR. SIZE(bt_v) /= nu .OR. &
+        SIZE(k_u) /= nu .OR. SIZE(b_k_u) /= nc .OR. SIZE(d_v) /= nc ) &
+        CALL Fatal('BlockSchurActionWork','Incompatible Schur work size')
+    CALL CRS_MatrixVectorMultiply(Bt,v,bt_v)
+    CALL BlockSchurCheckFinite('Bt*v',bt_v)
+    CALL BlockSchurReport('Bt*v',bt_v)
+    k_u = 0.0_dp
+    ! The same Solver_t owns the already-configured BoomerAMG hierarchy.  The
+    ! no-recompute flag is essential: a Schur matvec must not rebuild AMG.
+    CALL SolveLinearSystem(K,bt_v,k_u,KVar % Norm,KVar % DOFs,KSolver)
+    CALL BlockSchurCheckFinite('K solve',k_u)
+    CALL BlockSchurReport('K solve',k_u)
+    CALL CRS_MatrixVectorMultiply(B,k_u,b_k_u)
+    CALL BlockSchurCheckFinite('B*K^-1*Bt*v',b_k_u)
+    CALL BlockSchurReport('B*K^-1*Bt*v',b_k_u)
+    d_v = 0.0_dp
+    IF( ASSOCIATED(D) ) THEN
+      IF( D % NumberOfRows > 0 ) CALL CRS_MatrixVectorMultiply(D,v,d_v)
+    END IF
+    CALL BlockSchurReport('D*v',d_v)
+    y = d_v - b_k_u
+    CALL BlockSchurCheckFinite('Schur output',y)
+    CALL BlockSchurReport('Schur output',y)
+  END SUBROUTINE BlockSchurActionWork
+
+
+  !------------------------------------------------------------------------------
+  !> Solve S x = rhs with restarted right-preconditioned GMRES.
+  !>
+  !> The Schur operator is matrix-free and each K action reuses the caller's
+  !> K Solver_t (BoomerAMG on CPU/CUDA/HIP).  The small diagonal extracted by
+  !> BlockSchurPrepareDiagonal is used only as the inner Schur preconditioner.
+  !------------------------------------------------------------------------------
+  SUBROUTINE BlockSchurMatrixFreeSolve( rhs, sol, KSolver, KVar, DiagS, &
+      SchurTol, SchurMaxIter, SchurRestart )
+    REAL(KIND=dp), INTENT(in) :: rhs(:), DiagS(:)
+    REAL(KIND=dp), INTENT(inout) :: sol(:)
+    TYPE(Solver_t), POINTER :: KSolver
+    TYPE(Variable_t), POINTER :: KVar
+    REAL(KIND=dp), INTENT(in) :: SchurTol
+    INTEGER, INTENT(in) :: SchurMaxIter, SchurRestart
+    REAL(KIND=dp), ALLOCATABLE :: r(:),w(:),z(:),v(:,:),zz(:,:),h(:,:), &
+        cs(:),sn(:),g(:),coef(:),ax(:),sbt(:),sku(:),sbku(:),sdv(:)
+    REAL(KIND=dp) :: beta,res,den,tmp
+    INTEGER :: n,m,i,j,k,iter,istat,nu
+    LOGICAL :: Found,OldNoPrec
+
+    n = SIZE(rhs)
+    IF( SIZE(sol) /= n .OR. SIZE(DiagS) /= n ) CALL Fatal( &
+        'BlockSchurMatrixFreeSolve','Incompatible Schur solve sizes')
+    IF( SchurMaxIter < 1 .OR. SchurRestart < 1 ) CALL Fatal( &
+        'BlockSchurMatrixFreeSolve','Schur iteration settings must be positive')
+    m = MIN(SchurMaxIter,SchurRestart)
+    nu = TotMatrix % Submatrix(1,1) % Mat % NumberOfRows
+    ALLOCATE(r(n),w(n),z(n),v(n,m+1),zz(n,m),h(m+1,m),cs(m),sn(m), &
+        g(m+1),coef(m),ax(n),sbt(nu),sku(nu), &
+        sbku(n),sdv(n),STAT=istat)
+    IF( istat /= 0 ) CALL Fatal('BlockSchurMatrixFreeSolve', &
+        'Allocation error for Schur GMRES work vectors')
+    CALL BlockSchurCheckFinite('Schur diagonal preconditioner',DiagS)
+
+    OldNoPrec = ListGetLogical(KSolver % Values,'No Precondition Recompute',Found)
+    CALL ListAddLogical(KSolver % Values,'No Precondition Recompute',.TRUE.)
+    iter = 0
+    sol = 0.0_dp
+    CALL BlockSchurActionWork(sol,r,KSolver,KVar,sbt,sku,sbku,sdv)
+    r = rhs - r
+    CALL BlockSchurCheckFinite('Schur residual',r)
+    beta = SQRT(MAX(0.0_dp,DOT_PRODUCT(r,r)))
+    CALL BlockSchurCheckScalarFinite('initial residual',beta)
+    IF( beta <= SchurTol * MAX(SQRT(MAX(0.0_dp,DOT_PRODUCT(rhs,rhs))), &
+        TINY(1.0_dp)) ) GOTO 900
+
+    DO WHILE( iter < SchurMaxIter )
+      beta = SQRT(MAX(0.0_dp,DOT_PRODUCT(r,r)))
+      CALL BlockSchurCheckScalarFinite('restart residual',beta)
+      IF( beta <= SchurTol * MAX(SQRT(MAX(0.0_dp,DOT_PRODUCT(rhs,rhs))), &
+          TINY(1.0_dp)) ) EXIT
+      v = 0.0_dp; zz = 0.0_dp; h = 0.0_dp; cs = 0.0_dp; sn = 0.0_dp
+      g = 0.0_dp; g(1) = beta; v(:,1) = r / beta
+      k = 0
+      DO j=1,m
+        IF( iter >= SchurMaxIter ) EXIT
+        k = j; iter = iter + 1
+        z = v(:,j) / DiagS
+        CALL BlockSchurCheckFinite('preconditioned vector',z)
+        zz(:,j) = z
+        CALL BlockSchurActionWork(z,w,KSolver,KVar,sbt,sku,sbku,sdv)
+        DO i=1,j
+          h(i,j) = DOT_PRODUCT(v(:,i),w)
+          w = w - h(i,j)*v(:,i)
+        END DO
+        h(j+1,j) = SQRT(MAX(0.0_dp,DOT_PRODUCT(w,w)))
+        CALL BlockSchurCheckScalarFinite('Arnoldi residual',h(j+1,j))
+        IF( h(j+1,j) > TINY(1.0_dp) ) v(:,j+1) = w / h(j+1,j)
+        DO i=1,j-1
+          tmp = cs(i)*h(i,j) + sn(i)*h(i+1,j)
+          h(i+1,j) = -sn(i)*h(i,j) + cs(i)*h(i+1,j)
+          h(i,j) = tmp
+        END DO
+        den = SQRT(h(j,j)*h(j,j) + h(j+1,j)*h(j+1,j))
+        IF( den <= TINY(1.0_dp) ) THEN
+          cs(j) = 1.0_dp; sn(j) = 0.0_dp
+        ELSE
+          cs(j) = h(j,j)/den; sn(j) = h(j+1,j)/den
+        END IF
+        h(j,j) = cs(j)*h(j,j) + sn(j)*h(j+1,j)
+        h(j+1,j) = 0.0_dp
+        g(j+1) = -sn(j)*g(j); g(j) = cs(j)*g(j)
+        res = ABS(g(j+1))
+        CALL BlockSchurCheckScalarFinite('inner residual',res)
+        IF( res <= SchurTol * MAX(SQRT(MAX(0.0_dp,DOT_PRODUCT(rhs,rhs))), &
+            TINY(1.0_dp)) ) EXIT
+      END DO
+      IF( k == 0 ) EXIT
+      coef = 0.0_dp
+      DO i=k,1,-1
+        coef(i) = g(i)
+        IF( i < k ) coef(i) = coef(i) - DOT_PRODUCT(h(i,i+1:k), &
+            coef(i+1:k))
+        IF( ABS(h(i,i)) <= TINY(1.0_dp) ) THEN
+          coef(i) = 0.0_dp
+        ELSE
+          coef(i) = coef(i) / h(i,i)
+        END IF
+      END DO
+      DO j=1,k
+        sol = sol + coef(j)*zz(:,j)
