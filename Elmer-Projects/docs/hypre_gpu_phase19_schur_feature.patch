diff --git a/fem/src/SolveSuperLUStandard.c b/fem/src/SolveSuperLUStandard.c
new file mode 100644
--- /dev/null
+++ b/fem/src/SolveSuperLUStandard.c
@@ -0,0 +1,47 @@
+/* Minimal serial SuperLU wrapper used by the matrix-free Schur diagnostic. */
+
+#include <stdlib.h>
+#include <superlu/slu_ddefs.h>
+
+void block_schur_superlu_solve(int *n, int *nnz, double *values,
+                               int *rowind, int *colptr, double *rhs,
+                               int *info)
+{
+    SuperMatrix A, B, L, U;
+    superlu_options_t options;
+    SuperLUStat_t stat;
+    int *perm_c = NULL;
+    int *perm_r = NULL;
+    int i;
+
+    *info = -1;
+    perm_c = (int *) malloc((size_t) *n * sizeof(int));
+    perm_r = (int *) malloc((size_t) *n * sizeof(int));
+    if (perm_c == NULL || perm_r == NULL) goto cleanup;
+
+    /* Elmer's CRS indices are one-based; SuperLU expects zero-based CSC. */
+    for (i = 0; i < *nnz; ++i) --rowind[i];
+    for (i = 0; i <= *n; ++i) --colptr[i];
+
+    dCreate_CompCol_Matrix(&A, *n, *n, *nnz, values, rowind, colptr,
+                           SLU_NC, SLU_D, SLU_GE);
+    dCreate_Dense_Matrix(&B, *n, 1, rhs, *n, SLU_DN, SLU_D, SLU_GE);
+    set_default_options(&options);
+    options.ColPerm = COLAMD;
+    StatInit(&stat);
+    dgssv(&options, &A, perm_c, perm_r, &L, &U, &B, &stat, info);
+    StatFree(&stat);
+    Destroy_SuperMatrix_Store(&A);
+    Destroy_SuperNode_Matrix(&L);
+    Destroy_CompCol_Matrix(&U);
+    Destroy_SuperMatrix_Store(&B);
+
+    for (i = 0; i < *nnz; ++i) ++rowind[i];
+    for (i = 0; i <= *n; ++i) ++colptr[i];
+
+cleanup:
+    free(perm_c);
+    free(perm_r);
+}
+
+

