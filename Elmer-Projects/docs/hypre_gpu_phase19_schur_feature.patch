+  !------------------------------------------------------------------------------
+  !> Fail before a non-finite Schur stage can enter either Krylov iteration.
+  !------------------------------------------------------------------------------
+  SUBROUTINE BlockSchurCheckFinite(Stage, Values)
+    CHARACTER(LEN=*), INTENT(in) :: Stage
+    REAL(KIND=dp), INTENT(in) :: Values(:)
+    IF( ANY(Values /= Values) .OR. ANY(ABS(Values) > HUGE(1.0_dp)) ) THEN
+      CALL Fatal('BlockSchurAction','Non-finite value after '//TRIM(Stage))
+    END IF
+  END SUBROUTINE BlockSchurCheckFinite
+
+
+  SUBROUTINE BlockSchurReport(Stage, Values)
+    CHARACTER(LEN=*), INTENT(in) :: Stage
+    REAL(KIND=dp), INTENT(in) :: Values(:)
+    INTEGER :: n, nonzero
+    REAL(KIND=dp) :: nrm, vmin, vmax
+    LOGICAL :: finite
+    CHARACTER(256) :: Report
+
+    n = SIZE(Values)
+    finite = .NOT. (ANY(Values /= Values) .OR. ANY(ABS(Values) > HUGE(1.0_dp)))
+    nonzero = COUNT(Values /= 0.0_dp)
+    IF( n > 0 ) THEN
+      nrm = SQRT(SUM(Values*Values))
+      vmin = MINVAL(Values)
+      vmax = MAXVAL(Values)
+    ELSE
+      nrm = 0.0_dp
+      vmin = 0.0_dp
+      vmax = 0.0_dp
+    END IF
+    WRITE(Report,'(A,A,A,I0,A,ES12.5,A,ES12.5,A,ES12.5,A,I0,A,L1)') &
+        'stage=',TRIM(Stage),' n=',n,' norm=',nrm,' min=',vmin,' max=',vmax, &
+        ' nonzero=',nonzero,' finite=',finite
+    CALL Info('BlockSchurDiagnostic',Report,Level=5)
+  END SUBROUTINE BlockSchurReport
+
