+  SUBROUTINE BlockSchurSuperLUSolve(A, Rhs, Sol, InfoCode)
+    TYPE(Matrix_t), POINTER :: A
+    REAL(KIND=dp), INTENT(in) :: Rhs(:)
+    REAL(KIND=dp), INTENT(out) :: Sol(:)
+    INTEGER, INTENT(out) :: InfoCode
+    INTERFACE
+      SUBROUTINE block_schur_superlu_solve(n,nnz,values,rowind,colptr,rhs,info) &
+          BIND(C,NAME='block_schur_superlu_solve')
+        USE, INTRINSIC :: ISO_C_BINDING, ONLY : C_INT, C_DOUBLE
+        INTEGER(C_INT) :: n,nnz,rowind(*),colptr(*),info
+        REAL(C_DOUBLE) :: values(*),rhs(*)
+      END SUBROUTINE block_schur_superlu_solve
+    END INTERFACE
+    INTEGER :: n, nnz
+
+    n = A % NumberOfRows
