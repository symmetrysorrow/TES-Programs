+/* Inspect an expression without evaluating it.  The MATC lexer/parser use
+ * thread-local static cursors and the shared MATC allocation list, so run
+ * parsing with saved cursors and a private allocation list. */
+static int temperature_tree_is_pure(TREE *root, int depth, int *nodes)
+{
+  if (root == NULL || depth > 256 || ++(*nodes) > 4096) return FALSE;
+  if (NEXT(root) != NULL || LINK(root) != NULL || SUBS(root) != NULL) return FALSE;
+  switch (ETYPE(root))
+  {
+    case ETYPE_NUMBER:
+      return ARGS(root) == NULL && LEFT(root) == NULL && RIGHT(root) == NULL;
+    case ETYPE_EQUAT:
+      return ARGS(root) == NULL && LEFT(root) != NULL && RIGHT(root) == NULL &&
+             temperature_tree_is_pure(LEFT(root), depth + 1, nodes);
+    case ETYPE_NAME:
+      if (SDATA(root) == NULL) return FALSE;
+      if (strcmp(SDATA(root), "tx") == 0)
+        return ARGS(root) == NULL && com_check("tx") == NULL && fnc_check("tx") == NULL;
+      if (strcmp(SDATA(root), "abs") == 0 && ARGS(root) != NULL &&
+          NEXT(ARGS(root)) == NULL && LINK(ARGS(root)) == NULL && fnc_check("abs") == NULL)
+      {
+        COMMAND *cmd = com_check("abs");
+        /* CMDFLAG_PW means element-wise execution, not purity.  Purity is
+         * established here by the exact registered function identity; the
+         * audited func_abs implementation only returns abs(arg). */
+        if (cmd == NULL || cmd->sub != (VARIABLE *(*)())func_abs ||
+            cmd->minp != 1 || cmd->maxp != 1) return FALSE;
+        return temperature_tree_is_pure(ARGS(root), depth + 1, nodes);
+      }
+      return FALSE;
+    case ETYPE_OPER:
+      if (ARGS(root) != NULL || LEFT(root) == NULL) return FALSE;
+      if (VDATA(root) == opr_minus)
+        return RIGHT(root) == NULL && temperature_tree_is_pure(LEFT(root), depth + 1, nodes);
+      if (VDATA(root) == opr_add || VDATA(root) == opr_subs ||
+          VDATA(root) == opr_mul || VDATA(root) == opr_div || VDATA(root) == opr_pow)
+        return RIGHT(root) != NULL &&
+               temperature_tree_is_pure(LEFT(root), depth + 1, nodes) &&
+               temperature_tree_is_pure(RIGHT(root), depth + 1, nodes);
+      return FALSE;
+    default:
+      return FALSE;
+  }
+}
+
+int matc_parse_temperature_only_expression(const char *expression)
+{
+  SYMTYPE saved_symbol = symbol, saved_bendsym = bendsym;
+  char saved_csymbol[sizeof(csymbol)], saved_buf[sizeof(buf)];
+  char *saved_str = str;
+  LIST *saved_alloc_head = ALLOC_HEAD;
+  jmp_buf local_jmp;
+  jmp_buf *saved_jmpbuf = jmpbuf;
+  CLAUSE *root;
+  int nodes = 0, jump_status;
+  volatile int accepted = FALSE;
+  size_t length;
+
+  if (expression == NULL) return FALSE;
+  length = strlen(expression);
+  if (length == 0 || length >= sizeof(buf)) return FALSE;
+  memcpy(saved_csymbol, csymbol, sizeof(csymbol));
+  memcpy(saved_buf, buf, sizeof(buf));
+
+  ALLOC_HEAD = NULL;
+  jmpbuf = &local_jmp;
+  jump_status = setjmp(local_jmp);
+  if (jump_status == 0)
+  {
+    str = buf;
+    memcpy(buf, expression, length + 1);
+    scan();
+    if (symbol != nullsym)
+    {
+      root = parse();
+      /* One expression statement has a single RHS clause. */
+      if (symbol == nullsym && root != NULL && root->data == assignsym &&
+          root->this == NULL && LINK(root) != NULL && LINK(root)->this != NULL &&
+          LINK(root)->link == NULL)
+        accepted = temperature_tree_is_pure(LINK(root)->this, 0, &nodes);
+    }
+  }
+
+  /* error_matc() already freed this private list before longjmp. */
+  mem_free_all();
+  ALLOC_HEAD = saved_alloc_head;
+  jmpbuf = saved_jmpbuf;
+  str = saved_str;
+  symbol = saved_symbol;
+  bendsym = saved_bendsym;
+  memcpy(csymbol, saved_csymbol, sizeof(csymbol));
+  memcpy(buf, saved_buf, sizeof(buf));
+  return accepted;
+}
