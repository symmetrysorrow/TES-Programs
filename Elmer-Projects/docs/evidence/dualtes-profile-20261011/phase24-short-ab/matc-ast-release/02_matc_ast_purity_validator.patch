+/* Parse-only safety gate. Isolate MATC's diagnostic string so syntax errors
+ * cannot replace the caller's last evaluation result. */
+int mtc_expression_is_temperature_only(const char *expression)
+{
+  char *saved_output = math_out_str;
+  int saved_count = math_out_count;
+  int saved_allocated = math_out_allocated;
+  int accepted;
+
+  math_out_str = NULL;
+  math_out_count = 0;
+  math_out_allocated = 0;
+  accepted = matc_parse_temperature_only_expression(expression);
+  free(math_out_str);
+  math_out_str = saved_output;
+  math_out_count = saved_count;
+  math_out_allocated = saved_allocated;
+  return accepted;
+}
