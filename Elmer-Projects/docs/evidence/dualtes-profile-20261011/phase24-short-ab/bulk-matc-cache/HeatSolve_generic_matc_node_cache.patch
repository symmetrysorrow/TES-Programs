+    IF (ALLOCATED(Phase24GenericKCount)) DEALLOCATE(Phase24GenericKCount)
+    Phase24GenericKMatCount = 0
+    Phase24GenericKNodeCount = 0
+    Phase24GenericKCacheReady = .FALSE.
+  END SUBROUTINE Phase24ClearGenericDynKCache
