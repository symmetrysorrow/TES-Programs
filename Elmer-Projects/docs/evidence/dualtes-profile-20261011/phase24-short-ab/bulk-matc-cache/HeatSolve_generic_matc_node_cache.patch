+  SUBROUTINE Phase24ClearGenericDynKCache()
+    IF (ALLOCATED(Phase24GenericKNodeSlot)) DEALLOCATE(Phase24GenericKNodeSlot)
+    IF (ALLOCATED(Phase24GenericKNodes)) DEALLOCATE(Phase24GenericKNodes)
+    IF (ALLOCATED(Phase24GenericKNodal)) DEALLOCATE(Phase24GenericKNodal)
