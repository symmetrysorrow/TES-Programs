+  SUBROUTINE Phase24BuildGenericDynKCache()
+    INTEGER :: e,m,k,j,matId,nBulk,nNodes,node,nDynNodes,slot,nK
+    INTEGER, ALLOCATABLE :: NodeMark(:)
+    LOGICAL :: found,gotMat
+    REAL(KIND=dp) :: cacheBuildStart
+    TYPE(Element_t), POINTER :: el
+    TYPE(ValueList_t), POINTER :: mat
+
+    CALL Phase24ClearGenericDynKCache()
+    cacheBuildStart = RealTime()
+    nBulk = Solver % Mesh % NumberOfBulkElements
+    nNodes = Solver % Mesh % NumberOfNodes
+    ALLOCATE(Phase24GenericKNodeSlot(6,nBulk))
+    Phase24GenericKNodeSlot = 0
+    ALLOCATE(Phase24GenericKMats(MAX(1,CurrentModel % NumberOfMaterials)), &
+         Phase24GenericKStart(MAX(1,CurrentModel % NumberOfMaterials)), &
+         Phase24GenericKCount(MAX(1,CurrentModel % NumberOfMaterials)))
+    Phase24GenericKMatCount = 0
+    DO e=1,nBulk
+      el => Solver % Mesh % Elements(e)
+      IF (.NOT. ASSOCIATED(el % TYPE)) CYCLE
+      IF (el % TYPE % ElementCode /= 706) CYCLE
+      IF (SIZE(el % NodeIndexes) < 6) CYCLE
+      IF (el % BodyId <= 0 .OR. el % BodyId > CurrentModel % NumberOfBodies) CYCLE
+      matId = ListGetInteger(CurrentModel % Bodies(el % BodyId) % Values,'Material',gotMat)
+      IF (.NOT. gotMat .OR. matId <= 0 .OR. matId > CurrentModel % NumberOfMaterials) CYCLE
+      mat => CurrentModel % Materials(matId) % Values
+      IF (.NOT. Phase24IsTemperatureOnlyMatc(mat)) CYCLE
+      IF (.NOT. ANY(Phase24GenericKMats(1:Phase24GenericKMatCount) == matId)) THEN
+        Phase24GenericKMatCount = Phase24GenericKMatCount + 1
+        Phase24GenericKMats(Phase24GenericKMatCount) = matId
+      END IF
+    END DO
+    IF (Phase24GenericKMatCount == 0) THEN
+      Phase24GenericKCacheReady = .TRUE.
+      CALL Info('HeatSolve','Phase24 dynamic-k generic cache: no safe temperature-only MATC prisms',Level=4)
+      IF (Phase24DynKNodeCacheVerify) WRITE(*,'(A,I0,A,ES12.4)') &
+           'PHASE24_MATC_CACHE_BUILD rank=',ParEnv % MyPE,', wall_seconds=',RealTime()-cacheBuildStart
+      RETURN
+    END IF
+    ALLOCATE(NodeMark(nNodes))
+    nDynNodes = 0
+    DO m=1,Phase24GenericKMatCount
+      NodeMark = 0
+      Phase24GenericKStart(m) = nDynNodes + 1
+      DO e=1,nBulk
+        el => Solver % Mesh % Elements(e)
+        IF (.NOT. ASSOCIATED(el % TYPE)) CYCLE
+        IF (el % TYPE % ElementCode /= 706 .OR. SIZE(el % NodeIndexes) < 6) CYCLE
+        IF (el % BodyId <= 0 .OR. el % BodyId > CurrentModel % NumberOfBodies) CYCLE
+        matId = ListGetInteger(CurrentModel % Bodies(el % BodyId) % Values,'Material',gotMat)
+        IF (.NOT. gotMat .OR. matId /= Phase24GenericKMats(m)) CYCLE
+        DO j=1,6
+          node = el % NodeIndexes(j)
+          IF (node <= 0 .OR. node > nNodes) CYCLE
+          IF (NodeMark(node) == 0) THEN
+            nDynNodes = nDynNodes + 1
+            NodeMark(node) = nDynNodes
+          END IF
+          Phase24GenericKNodeSlot(j,e) = NodeMark(node)
+        END DO
+      END DO
+      Phase24GenericKCount(m) = nDynNodes - Phase24GenericKStart(m) + 1
+    END DO
+    ALLOCATE(Phase24GenericKNodes(nDynNodes),Phase24GenericKNodal(nDynNodes))
+    DO e=1,nBulk
+      el => Solver % Mesh % Elements(e)
+      IF (.NOT. ASSOCIATED(el % TYPE)) CYCLE
+      IF (el % TYPE % ElementCode /= 706 .OR. SIZE(el % NodeIndexes) < 6) CYCLE
+      DO j=1,6
+        slot = Phase24GenericKNodeSlot(j,e)
+        IF (slot > 0) Phase24GenericKNodes(slot) = el % NodeIndexes(j)
+      END DO
+    END DO
+    Phase24GenericKNodal = 0.0_dp
+    Phase24GenericKNodeCount = nDynNodes
+    Phase24GenericKCacheReady = .TRUE.
+    DEALLOCATE(NodeMark)
+    DO m=1,Phase24GenericKMatCount
+      WRITE(Message,'(A,I0,A,I0)') 'Phase24 generic dynamic-k cache material=', &
+           Phase24GenericKMats(m),', unique_nodes=',Phase24GenericKCount(m)
+      CALL Info('HeatSolve',TRIM(Message),Level=4)
+    END DO
+    IF (Phase24DynKNodeCacheVerify) WRITE(*,'(A,I0,A,I0,A,I0,A,ES12.4)') &
+         'PHASE24_MATC_CACHE_BUILD rank=',ParEnv % MyPE,', materials=',Phase24GenericKMatCount, &
+         ', unique_nodes=',Phase24GenericKNodeCount,', wall_seconds=',RealTime()-cacheBuildStart
+  END SUBROUTINE Phase24BuildGenericDynKCache
+
+  SUBROUTINE Phase24EvaluateGenericDynKCache()
+    INTEGER :: m,a,c
+    LOGICAL :: gotK
+    REAL(KIND=dp) :: cacheEvalStart
+    cacheEvalStart = RealTime()
+    DO m=1,Phase24GenericKMatCount
+      a=Phase24GenericKStart(m); c=Phase24GenericKCount(m)
+      IF (c <= 0) CYCLE
+      Phase24GenericKMatcCalls = Phase24GenericKMatcCalls + 1
+      Phase24GenericKNodal(a:a+c-1) = ListGetReal( &
+           CurrentModel % Materials(Phase24GenericKMats(m)) % Values, &
+           'Heat Conductivity',c,Phase24GenericKNodes(a:a+c-1),gotK)
+      IF (.NOT. gotK) CALL Fatal('HeatSolve','Phase24 generic dynamic-k cache evaluation failed')
+    END DO
+    IF (Phase24DynKNodeCacheVerify) WRITE(*,'(A,I0,A,I0,A,I0,A,I0,A,I0,A,ES12.4)') &
+         'PHASE24_MATC_CACHE_EVAL rank=',ParEnv % MyPE,', materials=',Phase24GenericKMatCount, &
+         ', unique_nodes=',Phase24GenericKNodeCount,', listgetreal_calls=',Phase24GenericKMatCount, &
+         ', previous_assembly_hits=',Phase24GenericKCacheHits,', wall_seconds=',RealTime()-cacheEvalStart
+  END SUBROUTINE Phase24EvaluateGenericDynKCache
+
+  LOGICAL FUNCTION Phase24IsTemperatureOnlyMatc(MaterialList)
+    TYPE(ValueList_t), POINTER :: MaterialList
+    TYPE(ValueListEntry_t), POINTER :: entry
+    CHARACTER(LEN=MAX_STRING_LEN) :: dependency
+    INTEGER :: nConductivity,nLower
+
+    Phase24IsTemperatureOnlyMatc = .FALSE.
+    entry => ListFind(MaterialList,'Heat Conductivity',Found)
+    IF (.NOT. ASSOCIATED(entry)) RETURN
+    IF (entry % TYPE /= LIST_TYPE_VARIABLE_SCALAR_STR) RETURN
+    IF (entry % PROCEDURE /= 0 .OR. entry % LuaFun) RETURN
+    IF (.NOT. ALLOCATED(entry % DependName)) RETURN
+    dependency = ADJUSTL(entry % DependName)
+    nLower = StringToLowerCase(dependency,entry % DependName)
+    IF (TRIM(dependency) /= 'temperature') RETURN
+    ! Additive/anisotropic conductivity entries change the property expression
+    ! and therefore invalidate the scalar nodal cache assumption.
+    nConductivity = 0
+    entry => MaterialList % Head
+    DO WHILE (ASSOCIATED(entry))
+      IF (INDEX(TRIM(entry % Name),'heat conductivity') == 1) nConductivity = nConductivity + 1
+      entry => entry % Next
+    END DO
+    IF (nConductivity /= 1) RETURN
+    Phase24IsTemperatureOnlyMatc = .TRUE.
+  END FUNCTION Phase24IsTemperatureOnlyMatc
+
