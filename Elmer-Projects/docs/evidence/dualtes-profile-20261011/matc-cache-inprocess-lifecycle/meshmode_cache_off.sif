Header
  CHECK KEYWORDS Warn
  Mesh DB "fixtures/meshes" "meshA"
End

Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Sizes(1) = 0.001
  Timestep Intervals(1) = 2
  Output Intervals(1) = 1
  Mesh Mode = Logical True
  Steady State Max Iterations = 1
  Output File = "meshmode_cacheoff.result"
End

Initial Condition 1
  Temperature = 1.0
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Variable DOFs = 1
  Phase24 Vector Assembly = Logical False
  Phase24 Dynamic K Node Cache = Logical False
  Phase24 Dynamic K Node Cache Verify = Logical False
  Phase24 Static Matrix Reuse = Logical False
  Nonlinear System Max Iterations = 8
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Relaxation Factor = 1.0
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
  Linear System Abort Not Converged = True
End

Equation 1
  Name = "Heat"
  Active Solvers(1) = 1
End

Material 1
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = 1.0
End
Material 2
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = 1.0
End
Material 3
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = 1.0
End
Material 4
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = 1.0
End
Material 5
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = 1.0
End
Material 6
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = 1.0
End
Material 7
  Name = "MATC prism"
  Density = 1.0
  Heat Capacity = 1.0
  Heat Conductivity = Variable Temperature
    Real MATC "1.0 + tx*tx"
End

Body Force 1
  Volumetric Heat Source = 1.0
End

Body 1
  Target Bodies(1) = 1
  Name = "Cache fixture prism"
  Equation = 1
  Material = 7
  Body Force = 1
End
