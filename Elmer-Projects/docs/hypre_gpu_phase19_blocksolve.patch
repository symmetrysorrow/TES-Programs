+Solver:Logical:     'Block Lower Triangular'
+Solver:Logical:     'Block Full Factorization'
+Solver:Logical:     'Block Schur Diagnostic'
+Solver:Logical:     'Block Schur Diagnostic Direct'
+Solver:String:      'Schur Diagnostic Prefix'
