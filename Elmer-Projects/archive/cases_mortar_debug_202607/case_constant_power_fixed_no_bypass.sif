INCLUDE "generated/tes_shared_variables.sif"
INCLUDE "generated/tes_case_constant_power.sif"

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh_shifted_merged"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 3D
  Simulation Type = Steady State
  Steady State Max Iterations = $ constant_power_steady_state_max_iterations
  Output Intervals = $ constant_power_output_intervals
  Solver Input File = case_constant_power_fixed_no_bypass.sif
  Post File = case_constant_power_fixed_no_bypass.ep
End

Initial Condition 1
  Temperature = $ T_initial_constant_power
End

Constants
  Stefan Boltzmann = Real 5.670374419e-8
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Variable DOFs = 1
  Calculate Loads = True
  Nonlinear System Max Iterations = $ constant_power_solver_nonlinear_max_iterations
  Nonlinear System Convergence Tolerance = $ constant_power_solver_nonlinear_convergence_tolerance
  Nonlinear System Relaxation Factor = $ constant_power_solver_nonlinear_relaxation_factor
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Apply Mortar BCs = True
  Steady State Convergence Tolerance = $ constant_power_solver_steady_state_convergence_tolerance
End

Solver 2
  Exec Solver = After Simulation
  Equation = Result Output
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "case_constant_power_fixed_no_bypass"
  Vtu Format = True
End

Equation 1
  Name = "Heat"
  Active Solvers(1) = 1
End

INCLUDE "generated/tes_materials.sif"

! SiO2_1 with the region directly under the membrane island (|x|<350um,
! |y-1mm|<350um) made non-conductive, so the island->sheet bypass is cut
! while the frame->bath series path through SiO2_1 stays intact.
Material 8
  Name = "SiO2_bypass_cut"
  Density = 2200
  Heat Capacity = 0.000124
  Heat Conductivity = Variable Coordinate
    Real MATC "4.94e-4 + (1.0e-10 - 4.94e-4)*((abs(tx(0)) < 3.5e-4)*(abs(tx(1) - 1.0e-3) < 3.5e-4))"
End

Body Force 1
  Name = "TES fixed power"
  Volumetric Heat Source = $ constant_power_volumetric_heat_source
End

Body 1
  Target Bodies(1) = 100
  Name = "abs"
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Body 2
  Target Bodies(1) = 101
  Name = "TES"
  Equation = 1
  Material = 2
  Body Force = 1
  Initial Condition = 1
End

Body 3
  Target Bodies(1) = 102
  Name = "Stycast"
  Equation = 1
  Material = 3
  Initial Condition = 1
End

Body 4
  Target Bodies(1) = 103
  Name = "Membrane_SiNx"
  Equation = 1
  Material = 7
  Initial Condition = 1
End

Body 5
  Target Bodies(1) = 104
  Name = "SiO2_1"
  Equation = 1
  Material = 8
  Initial Condition = 1
End

Body 6
  Target Bodies(1) = 105
  Name = "Si_1"
  Equation = 1
  Material = 5
  Initial Condition = 1
End

Body 7
  Target Bodies(1) = 106
  Name = "SiNx"
  Equation = 1
  Material = 6
  Initial Condition = 1
End

Body 8
  Target Bodies(1) = 107
  Name = "Si_2"
  Equation = 1
  Material = 5
  Initial Condition = 1
End

Body 9
  Target Bodies(1) = 108
  Name = "SiO2_2"
  Equation = 1
  Material = 4
  Initial Condition = 1
End

Body 10
  Target Bodies(1) = 109
  Name = "Membrane_Si1"
  Equation = 1
  Material = 7
  Initial Condition = 1
End

Boundary Condition 1
  Target Boundaries(1) = 1804
  Name = "bath on SiO2_2__zmin"
  Temperature = 0.15
End

Boundary Condition 2
  Target Boundaries(1) = 1104
  Name = "TES bottom mortar"
  Mortar BC = 3
  Galerkin Projector = True
  Plane Projector = True
End

Boundary Condition 3
  Target Boundaries(1) = 1305
  Name = "Membrane_SiNx top mortar"
End

Boundary Condition 4
  Target Boundaries(1) = 1204
  Name = "Stycast bottom mortar"
  Mortar BC = 5
  Galerkin Projector = True
  Plane Projector = True
End

Boundary Condition 5
  Target Boundaries(1) = 1105
  Name = "TES top mortar"
End

Boundary Condition 6
  Target Boundaries(1) = 1205
  Name = "Stycast top mortar"
  Mortar BC = 7
  Galerkin Projector = True
  Plane Projector = True
End

Boundary Condition 7
  Target Boundaries(1) = 1004
  Name = "Pb bottom mortar"
End
