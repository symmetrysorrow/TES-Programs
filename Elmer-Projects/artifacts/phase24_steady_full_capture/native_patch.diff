--- SolverUtils.F90 (diagnostic-only patch, external native source)
+++ SolverUtils.F90 (diagnostic-only patch, external native source)
@@
-  IF(.NOT.FullCaptureFound) FullCaptureStep = 1
+  ! Steady solves have no timestep variable and therefore use timestep 0.
+  ! Keep the transient default at 1, but allow an explicit 0 diagnostic step.
+  IF(.NOT.FullCaptureFound) THEN
+    FullCaptureStep = 1
+  ELSE IF(FullCaptureStep < 0) THEN
+    FullCaptureStep = 0
+  END IF
