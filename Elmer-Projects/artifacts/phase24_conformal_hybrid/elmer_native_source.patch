+  FUNCTION TESKey(kc, suffix) RESULT(key)
+    INTEGER, INTENT(IN) :: kc
+    CHARACTER(LEN=*), INTENT(IN) :: suffix
+    CHARACTER(:), ALLOCATABLE :: key
+    IF (TESNumbered) THEN
+      key = 'TES '//I2S(kc)//' '//suffix
+    ELSE
+      key = 'TES '//suffix
+    END IF
+  END FUNCTION TESKey
