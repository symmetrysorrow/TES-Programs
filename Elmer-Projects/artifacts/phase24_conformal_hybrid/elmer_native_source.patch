+!------------------------------------------------------------------------------
+!> Solve an explicit saddle-point system with Elmer GMRES while AMGX solves
+!> the leading thermal block in a block-triangular Schur preconditioner.
+!------------------------------------------------------------------------------
+  SUBROUTINE AMGXSchurSolve( A, x, b, Solver )
+    IMPLICIT NONE
+    TYPE(Matrix_t), TARGET :: A
+    REAL(KIND=dp), TARGET :: x(:), b(:)
+    TYPE(Solver_t), TARGET :: Solver
+    INTEGER :: i,j,k,n,m,q,r
+    INTEGER(KIND=AddrInt) :: AddrFunc
+    REAL(KIND=dp), ALLOCATABLE :: DiagA(:), Delta(:), Defect(:)
+    REAL(KIND=dp) :: cval,bval,s,abss,Gamma,NormB2,NormC2,Weight
+    LOGICAL :: FoundB, ILUStatus
+    EXTERNAL AddrFunc
+
+    n = A % NumberOfRows - A % ExtraDOFs
+    m = A % ExtraDOFs
+    IF(n <= 0 .OR. m <= 0) CALL Fatal('AMGXSchurSolve','Explicit constraint block not found')
+
+    AMGXSchurBlock => AllocateMatrix()
+    AMGXSchurBlock % FORMAT = MATRIX_LIST
+    DO i=1,n
+      DO j=A % Rows(i),A % Rows(i+1)-1
+        k = A % Cols(j)
+        IF(k <= n) CALL List_AddToMatrixElement(AMGXSchurBlock % ListMatrix,i,k,A % Values(j))
+      END DO
+    END DO
+
+    Gamma = ListGetConstReal(Solver % Values,'AMGX Schur Augmentation',FoundB)
+    IF(.NOT.FoundB) Gamma = 1.0_dp
+    IF(Gamma <= 0.0_dp) CALL Fatal('AMGXSchurSolve','AMGX Schur Augmentation must be positive')
+    DO i=1,m
+      NormB2 = 0.0_dp
+      NormC2 = 0.0_dp
+      DO j=A % Rows(n+i),A % Rows(n+i+1)-1
+        k = A % Cols(j)
+        IF(k <= 0 .OR. k > n) CYCLE
+        cval = A % Values(j)
+        bval = 0.0_dp
+        DO q=A % Rows(k),A % Rows(k+1)-1
+          IF(A % Cols(q) == n+i) THEN
+            bval = A % Values(q)
+            EXIT
+          END IF
+        END DO
+        NormB2 = NormB2 + bval*bval
+        NormC2 = NormC2 + cval*cval
+      END DO
+      IF(NormB2 <= TINY(1.0_dp) .OR. NormC2 <= TINY(1.0_dp)) CYCLE
+      Weight = Gamma/SQRT(NormB2*NormC2)
+
+      DO j=A % Rows(n+i),A % Rows(n+i+1)-1
+        k = A % Cols(j)
+        IF(k <= 0 .OR. k > n) CYCLE
+        bval = 0.0_dp
+        DO q=A % Rows(k),A % Rows(k+1)-1
+          IF(A % Cols(q) == n+i) THEN
+            bval = A % Values(q)
+            EXIT
+          END IF
+        END DO
+        IF(ABS(bval) <= AEPS) CYCLE
+        DO r=A % Rows(n+i),A % Rows(n+i+1)-1
+          q = A % Cols(r)
+          IF(q <= 0 .OR. q > n) CYCLE
+          cval = A % Values(r)
+          IF(ABS(cval) <= AEPS) CYCLE
+          CALL List_AddToMatrixElement(AMGXSchurBlock % ListMatrix,k,q, &
+              Weight*bval*cval)
+        END DO
+      END DO
+    END DO
+    CALL List_ToCRSMatrix(AMGXSchurBlock)
+    AMGXSchurBlock % Comm = A % Comm
+
+    ALLOCATE(DiagA(n),AMGXSchurDiag(m),AMGXSchurRhs(n),AMGXSchurLambda(m))
+    DiagA = 0.0_dp
+    DO i=1,n
+      DO j=AMGXSchurBlock % Rows(i),AMGXSchurBlock % Rows(i+1)-1
+        IF(AMGXSchurBlock % Cols(j) == i) THEN
+          DiagA(i) = AMGXSchurBlock % Values(j)
+          EXIT
+        END IF
+      END DO
+      IF(ABS(DiagA(i)) <= AEPS) DiagA(i) = 1.0_dp
+    END DO
+
+    DO i=1,m
+      s = 0.0_dp
+      abss = 0.0_dp
+      DO j=A % Rows(n+i),A % Rows(n+i+1)-1
+        k = A % Cols(j)
+        IF(k <= 0 .OR. k > n) CYCLE
+        cval = A % Values(j)
+        bval = 0.0_dp
+        FoundB = .FALSE.
+        BLOCK
+          INTEGER :: q
+          DO q=A % Rows(k),A % Rows(k+1)-1
+            IF(A % Cols(q) == n+i) THEN
+              bval = A % Values(q)
+              FoundB = .TRUE.
+              EXIT
+            END IF
+          END DO
+        END BLOCK
+        IF(.NOT.FoundB) CYCLE
+        s = s + cval*bval/DiagA(k)
+        abss = abss + ABS(cval*bval/DiagA(k))
+      END DO
+      IF(ABS(s) <= 1.0e-12_dp*MAX(abss,1.0_dp)) THEN
+        IF(abss > AEPS) THEN
+          s = abss
+        ELSE
+          s = 1.0_dp
+        END IF
+      END IF
+      AMGXSchurDiag(i) = s
+    END DO
+
+    AMGXSchurApprox => AllocateMatrix()
+    AMGXSchurApprox % FORMAT = MATRIX_LIST
+    DO i=1,m
+      CALL List_AddToMatrixElement(AMGXSchurApprox % ListMatrix,i,i,0.0_dp)
+      DO j=A % Rows(n+i),A % Rows(n+i+1)-1
+        k = A % Cols(j)
+        IF(k <= 0 .OR. k > n) CYCLE
+        cval = A % Values(j)/DiagA(k)
+        DO q=A % Rows(k),A % Rows(k+1)-1
+          r = A % Cols(q)-n
+          IF(r <= 0 .OR. r > m) CYCLE
+          CALL List_AddToMatrixElement(AMGXSchurApprox % ListMatrix,i,r, &
+              cval*A % Values(q))
+        END DO
+      END DO
+    END DO
+    CALL List_ToCRSMatrix(AMGXSchurApprox)
+    ILUStatus = CRS_IncompleteLU(AMGXSchurApprox,0,Solver % Values)
+    IF(.NOT.ILUStatus) CALL Fatal('AMGXSchurSolve','Approximate Schur ILU0 failed')
+    DEALLOCATE(DiagA)
+
+    CALL RowEquilibration(Solver,AMGXSchurBlock,Parallel=.FALSE.)
+
+    AMGXSchurN = n
+    AMGXSchurM = m
+    AMGXSchurFull => A
+    AMGXSchurParams => Solver
+    ! Solve for the correction rather than the full temperature field.  The
+    ! transient signal is many orders of magnitude smaller than the steady
+    ! state, so normalizing the Krylov residual by the full RHS can accept the
+    ! previous solution without resolving the pulse.
+    ALLOCATE(Delta(A % NumberOfRows),Defect(A % NumberOfRows))
+    CALL MatrixVectorMultiply(A,x,Defect)
+    Defect = b(1:A % NumberOfRows)-Defect
+    Delta = 0.0_dp
+    CALL Info('AMGXSchurSolve','Starting defect-correction Krylov solve with AMGX/Schur preconditioner',Level=5)
+    CALL IterSolver(A,Delta,Defect,Solver,PrecF=AddrFunc(AMGXSchurPrec))
