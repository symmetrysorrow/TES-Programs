+!------------------------------------------------------------------------------
+!> Replace B/C Lagrange multiplier constraints by a normalized penalty term.
+!> For [A B; C 0][u;lambda]=[b;g], this forms
+!> (A + gamma B C)u = b + gamma B g.  Row normalization makes gamma
+!> independent of the geometric scale of individual mortar elements.
+!------------------------------------------------------------------------------
+SUBROUTINE PenalizeLinearRestriction( StiffMatrix, RestMatrix, &
+    CollectionMatrix, Solver )
+  IMPLICIT NONE
+  TYPE(Matrix_t) :: StiffMatrix
+  TYPE(Matrix_t), POINTER :: RestMatrix
+  TYPE(Matrix_t) :: CollectionMatrix
+  TYPE(Solver_t) :: Solver
+
+  INTEGER :: i,j,l,row,col,n
+  REAL(KIND=dp) :: Gamma, NormB2, NormC2, Weight, RhsValue, Bval, Cval
+  REAL(KIND=dp), POINTER :: Bvals(:), Cvals(:), RestVector(:), CollectionVector(:)
+  TYPE(ListMatrix_t), POINTER :: Lmat(:)
+  TYPE(ValueList_t), POINTER :: Params
+  LOGICAL :: Found
+  CHARACTER(*), PARAMETER :: Caller = 'PenalizeLinearRestriction'
+
+  Params => Solver % Values
+  Gamma = ListGetConstReal( Params, 'Linear Constraint Penalty', Found )
+  IF(.NOT.Found) Gamma = 1.0e4_dp
+  IF(Gamma <= 0.0_dp) CALL Fatal(Caller,'Linear Constraint Penalty must be positive')
+
+  n = StiffMatrix % NumberOfRows
+  Cvals => RestMatrix % Values
+  Bvals => RestMatrix % TValues
+  IF(.NOT.ASSOCIATED(Bvals)) Bvals => Cvals
+  RestVector => RestMatrix % RHS
+  CollectionVector => CollectionMatrix % RHS
+
+  IF(CollectionMatrix % FORMAT /= MATRIX_LIST) CALL List_ToListMatrix(CollectionMatrix)
+  Lmat => CollectionMatrix % ListMatrix
+
+  CALL Info(Caller,'Applying normalized linear-constraint penalty',Level=6)
+
+  DO i=1,RestMatrix % NumberOfRows
+    NormB2 = 0.0_dp
+    NormC2 = 0.0_dp
+    RhsValue = RestVector(i)
+
+    DO j=RestMatrix % Rows(i),RestMatrix % Rows(i+1)-1
+      col = RestMatrix % Cols(j)
+      IF(col <= 0 .OR. col > n) CYCLE
+      IF(ALLOCATED(StiffMatrix % ConstrainedDOF)) THEN
+        IF(StiffMatrix % ConstrainedDOF(col)) THEN
+          RhsValue = RhsValue - Cvals(j) * StiffMatrix % DValues(col)
+          CYCLE
+        END IF
+      END IF
+      NormB2 = NormB2 + Bvals(j) * Bvals(j)
+      NormC2 = NormC2 + Cvals(j) * Cvals(j)
+    END DO
+
+    IF(NormB2 <= TINY(1.0_dp) .OR. NormC2 <= TINY(1.0_dp)) THEN
+      CALL Warn(Caller,'Skipping empty penalty constraint row: '//I2S(i))
+      CYCLE
+    END IF
+    Weight = Gamma / SQRT(NormB2 * NormC2)
+
+    DO j=RestMatrix % Rows(i),RestMatrix % Rows(i+1)-1
+      row = RestMatrix % Cols(j)
+      IF(row <= 0 .OR. row > n) CYCLE
+      IF(ALLOCATED(StiffMatrix % ConstrainedDOF)) THEN
+        IF(StiffMatrix % ConstrainedDOF(row)) CYCLE
+      END IF
+      Bval = Bvals(j)
+      IF(ABS(Bval) <= AEPS) CYCLE
+
+      DO l=RestMatrix % Rows(i),RestMatrix % Rows(i+1)-1
+        col = RestMatrix % Cols(l)
+        IF(col <= 0 .OR. col > n) CYCLE
+        IF(ALLOCATED(StiffMatrix % ConstrainedDOF)) THEN
+          IF(StiffMatrix % ConstrainedDOF(col)) CYCLE
+        END IF
+        Cval = Cvals(l)
+        IF(ABS(Cval) <= AEPS) CYCLE
+        CALL List_AddToMatrixElement(Lmat,row,col,Weight*Bval*Cval)
+      END DO
+      CollectionVector(row) = CollectionVector(row) + Weight*Bval*RhsValue
+    END DO
+  END DO
+
+  CALL Info(Caller,'Finished applying linear-constraint penalty',Level=8)
+END SUBROUTINE PenalizeLinearRestriction
+
   
 
