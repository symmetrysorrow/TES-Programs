+void STDCALLBULL FC_FUNC(solvehypre3,SOLVEHYPRE3)
+ (
+  int *nrows, int *rows, int *cols, double *vals, int *globaldofs,
+  int *verbosityPtr, int *structureEpochPtr, int *matrixEpochPtr,
