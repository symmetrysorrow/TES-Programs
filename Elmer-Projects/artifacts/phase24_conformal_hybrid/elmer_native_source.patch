+  !------------------------------------------------------------------------------
+  !> Fail before a non-finite Schur stage can enter either Krylov iteration.
+  !------------------------------------------------------------------------------
+  SUBROUTINE BlockSchurCheckFinite(Stage, Values)
+    CHARACTER(LEN=*), INTENT(in) :: Stage
+    REAL(KIND=dp), INTENT(in) :: Values(:)
+    IF( ANY(Values /= Values) .OR. ANY(ABS(Values) > HUGE(1.0_dp)) ) THEN
+      CALL Fatal('BlockSchurAction','Non-finite value after '//TRIM(Stage))
+    END IF
+  END SUBROUTINE BlockSchurCheckFinite
+
+
+  SUBROUTINE BlockSchurCheckScalarFinite(Stage, Value)
+    CHARACTER(LEN=*), INTENT(in) :: Stage
+    REAL(KIND=dp), INTENT(in) :: Value
+    IF( Value /= Value .OR. ABS(Value) > HUGE(1.0_dp) ) THEN
+      CALL Fatal('BlockSchurMatrixFreeSolve','Non-finite Schur GMRES residual after '//TRIM(Stage))
+    END IF
+  END SUBROUTINE BlockSchurCheckScalarFinite
+
