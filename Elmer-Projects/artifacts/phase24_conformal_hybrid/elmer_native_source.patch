+     Container->setup_since_last_solve = 0;
+   }
+   if (myverb > 8) fprintf(stdout,
+       "SolveHypre: refreshed matrix values in persistent IJ objects (%s preconditioner)\n",
+       refresh_setup ? "fresh" : "reused");
+}
 
