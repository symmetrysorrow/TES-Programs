+!------------------------------------------------------------------------------
+!> Block lower-triangular preconditioner callback for IterSolver.
+!------------------------------------------------------------------------------
+  SUBROUTINE AMGXSchurPrec( u, v, ipar )
+    IMPLICIT NONE
+    REAL(KIND=dp), INTENT(OUT) :: u(*)
+    REAL(KIND=dp), INTENT(IN) :: v(*)
+    INTEGER :: ipar(*)
+    INTEGER :: i,j,k
+    REAL(KIND=dp) :: cy
+
+    IF(.NOT.ASSOCIATED(AMGXSchurBlock) .OR. .NOT.ASSOCIATED(AMGXSchurFull) .OR. &
+        .NOT.ASSOCIATED(AMGXSchurParams)) &
+      CALL Fatal('AMGXSchurPrec','Preconditioner state is not initialized')
+
+    AMGXSchurRhs(1:AMGXSchurN) = &
+      AMGXSchurBlock % DiagScaling(1:AMGXSchurN)*v(1:AMGXSchurN)
+    u(1:AMGXSchurN) = 0.0_dp
+    CALL AMGXSolver(AMGXSchurBlock,u(1:AMGXSchurN),AMGXSchurRhs,AMGXSchurParams)
+
+    DO i=1,AMGXSchurM
+      cy = 0.0_dp
+      DO j=AMGXSchurFull % Rows(AMGXSchurN+i), &
+          AMGXSchurFull % Rows(AMGXSchurN+i+1)-1
+        k = AMGXSchurFull % Cols(j)
+        IF(k > 0 .AND. k <= AMGXSchurN) &
+          cy = cy + AMGXSchurFull % Values(j)*u(k)
+      END DO
+      AMGXSchurLambda(i) = cy-v(AMGXSchurN+i)
+    END DO
+    CALL CRS_LUSolve(AMGXSchurM,AMGXSchurApprox,AMGXSchurLambda)
+    u(AMGXSchurN+1:AMGXSchurN+AMGXSchurM) = AMGXSchurLambda
+
+  END SUBROUTINE AMGXSchurPrec
+!------------------------------------------------------------------------------
+
