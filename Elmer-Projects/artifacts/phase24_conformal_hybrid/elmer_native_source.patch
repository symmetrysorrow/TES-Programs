+!------------------------------------------------------------------------------
+!> Exact outer saddle-point solve with a diagonally stabilized full matrix as
+!> an AMGX preconditioner. Stabilization is confined to the preconditioner.
+!------------------------------------------------------------------------------
+  SUBROUTINE AMGXStabilizedSolve( A, x, b, Solver )
+    IMPLICIT NONE
+    TYPE(Matrix_t), TARGET :: A
+    REAL(KIND=dp), TARGET :: x(:), b(:)
+    TYPE(Solver_t), TARGET :: Solver
+    INTEGER :: i,j,k,n,nt
+    INTEGER(KIND=AddrInt) :: AddrFunc
+    REAL(KIND=dp) :: Stabilization
+    REAL(KIND=dp), ALLOCATABLE :: Delta(:), Defect(:)
+    LOGICAL :: Found
+    EXTERNAL AddrFunc
+
+    n = A % NumberOfRows
+    nt = n-A % ExtraDOFs
+    IF(nt <= 0 .OR. nt >= n) &
+      CALL Fatal('AMGXStabilizedSolve','Explicit constraint block not found')
+
+    Stabilization = ListGetConstReal(Solver % Values, &
+        'AMGX Constraint Stabilization',Found)
+    IF(.NOT.Found) Stabilization = 1.0_dp
+    IF(Stabilization <= 0.0_dp) &
+      CALL Fatal('AMGXStabilizedSolve','Constraint stabilization must be positive')
+
+    AMGXStabilizedMatrix => AllocateMatrix()
+    AMGXStabilizedMatrix % FORMAT = MATRIX_LIST
+    DO i=1,n
+      DO j=A % Rows(i),A % Rows(i+1)-1
+        k = A % Cols(j)
+        CALL List_AddToMatrixElement(AMGXStabilizedMatrix % ListMatrix, &
+            i,k,A % Values(j))
+      END DO
+      IF(i > nt) CALL List_AddToMatrixElement( &
+          AMGXStabilizedMatrix % ListMatrix,i,i,-Stabilization)
+    END DO
+    CALL List_ToCRSMatrix(AMGXStabilizedMatrix)
+    AMGXStabilizedMatrix % Comm = A % Comm
+    CALL RowEquilibration(Solver,AMGXStabilizedMatrix,Parallel=.FALSE.)
+
+    ALLOCATE(AMGXStabilizedRhs(n),Delta(n),Defect(n))
+    AMGXStabilizedN = n
+    AMGXStabilizedParams => Solver
+
+    CALL MatrixVectorMultiply(A,x,Defect)
+    Defect = b(1:n)-Defect
+    Delta = 0.0_dp
+    CALL Info('AMGXStabilizedSolve', &
+        'Starting defect-correction Krylov solve with stabilized AMGX preconditioner',Level=5)
+    CALL IterSolver(A,Delta,Defect,Solver,PrecF=AddrFunc(AMGXStabilizedPrec))
+    x(1:n) = x(1:n)+Delta
+
+    CALL FreeMatrix(AMGXStabilizedMatrix)
+    AMGXStabilizedMatrix => NULL()
+    AMGXStabilizedParams => NULL()
+    AMGXStabilizedN = 0
+    DEALLOCATE(AMGXStabilizedRhs,Delta,Defect)
+  END SUBROUTINE AMGXStabilizedSolve
+
+
+!------------------------------------------------------------------------------
+  SUBROUTINE AMGXStabilizedPrec( u, v, ipar )
+    IMPLICIT NONE
+    REAL(KIND=dp), INTENT(OUT) :: u(*)
+    REAL(KIND=dp), INTENT(IN) :: v(*)
+    INTEGER :: ipar(*)
+
