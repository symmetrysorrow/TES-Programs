+        .NOT.ASSOCIATED(AMGXStabilizedParams)) &
+      CALL Fatal('AMGXStabilizedPrec','Preconditioner state is not initialized')
+    AMGXStabilizedRhs = AMGXStabilizedMatrix % &
+        DiagScaling(1:AMGXStabilizedN)*v(1:AMGXStabilizedN)
+    u(1:AMGXStabilizedN) = 0.0_dp
+    CALL AMGXSolver(AMGXStabilizedMatrix,u(1:AMGXStabilizedN), &
+        AMGXStabilizedRhs,AMGXStabilizedParams)
+  END SUBROUTINE AMGXStabilizedPrec
