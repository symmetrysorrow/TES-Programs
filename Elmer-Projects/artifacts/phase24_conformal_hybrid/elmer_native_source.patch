+      ALLOCATE(NewPositions(36,newCapacity), NewIndices(6,newCapacity))
+      NewPositions = 0
+      NewIndices = 0
+      IF (Phase24CacheCapacity > 0) THEN
+        NewPositions(:,1:Phase24CacheCapacity) = Phase24PositionCache
+        NewIndices(:,1:Phase24CacheCapacity) = Phase24IndexCache
+      END IF
+      CALL MOVE_ALLOC(NewPositions, Phase24PositionCache)
+      CALL MOVE_ALLOC(NewIndices, Phase24IndexCache)
+      Phase24CacheCapacity = newCapacity
+    END IF
+    !$OMP END CRITICAL (PHASE24_POSITION_CACHE_SETUP)
+
+    Rows => Gmtr % Rows
+    Cols => Gmtr % Cols
+    Values => Gmtr % Values
+    Valid = ALL(Phase24PositionCache(1:N*N,ElementIndex) > 0) .AND. &
+            ALL(Phase24IndexCache(1:N,ElementIndex) == Indices(1:N))
+    IF (N == 4) Valid = Valid .AND. ALL(Phase24IndexCache(5:6,ElementIndex) == 0)
+
+    IF (.NOT. Valid) THEN
+      ! Two threads can legitimately reach the same cold cache entry when a
+      ! caller uses an uncoloured loop.  Serialize only this one-time lookup;
+      ! all subsequent assemblies take the lock-free update path.
+      !$OMP CRITICAL (PHASE24_POSITION_CACHE_BUILD)
+      Valid = ALL(Phase24PositionCache(1:N*N,ElementIndex) > 0) .AND. &
+              ALL(Phase24IndexCache(1:N,ElementIndex) == Indices(1:N))
+      IF (N == 4) Valid = Valid .AND. ALL(Phase24IndexCache(5:6,ElementIndex) == 0)
+      IF (.NOT. Valid) THEN
+        Phase24PositionCache(:,ElementIndex) = 0
+        Phase24IndexCache(:,ElementIndex) = 0
+        Phase24IndexCache(1:N,ElementIndex) = Indices(1:N)
+        DO i=1,N
+          row = Indices(i)
+          IF (row <= 0 .OR. row > Gmtr % NumberOfRows) EXIT
+          IF (Rows(row+1) <= Rows(row)) EXIT
+          DO j=1,N
+            col = Indices(j)
+            IF (col <= 0) EXIT
+            localIndex = CRS_Search(Rows(row+1)-Rows(row), &
+                 Cols(Rows(row):Rows(row+1)-1), col)
+            IF (localIndex <= 0) EXIT
+            p = N*(i-1)+j
+            Phase24PositionCache(p,ElementIndex) = Rows(row)+localIndex-1
+          END DO
+        END DO
+        Valid = ALL(Phase24PositionCache(1:N*N,ElementIndex) > 0)
+        IF (Valid) Phase24CacheBuildCount = Phase24CacheBuildCount + 1
+      END IF
+      !$OMP END CRITICAL (PHASE24_POSITION_CACHE_BUILD)
+    END IF
+
+    IF (.NOT. Valid) THEN
+      Phase24PositionCache(:,ElementIndex) = 0
+      CALL CRS_GlueLocalMatrixVec(Gmtr, N, NDOFs, Indices, Lmtr, MCAssembly, MaskedAssembly)
+      RETURN
+    END IF
+
+    !$OMP ATOMIC UPDATE
+    Phase24CacheHitCount = Phase24CacheHitCount + 1
+
+    DO i=1,N
+      DO j=1,N
+        p = N*(i-1)+j
+        IF (MCAssembly) THEN
+          Values(Phase24PositionCache(p,ElementIndex)) = &
+               Values(Phase24PositionCache(p,ElementIndex)) + Lmtr(i,j)
+        ELSE
+          !$OMP ATOMIC
+          Values(Phase24PositionCache(p,ElementIndex)) = &
+               Values(Phase24PositionCache(p,ElementIndex)) + Lmtr(i,j)
+        END IF
+      END DO
+    END DO
+  END SUBROUTINE CRS_GlueLocalMatrixCached
+
+  !> Add a local matrix into an array parallel to Gmtr % Values (e.g. a
+  !> preconditioning-matrix delta), reusing the destinations cached by a
+  !> preceding CRS_GlueLocalMatrixCached call for the same element.  Entries
+  !> without a valid cache are skipped.
+  SUBROUTINE CRS_AddLocalMatrixCachedTo(N, ElementIndex, Indices, Lmtr, Target)
+    INTEGER, INTENT(IN) :: N, ElementIndex
+    INTEGER, INTENT(IN) :: Indices(:)
+    REAL(KIND=dp), INTENT(IN) :: Lmtr(:,:)
+    REAL(KIND=dp), INTENT(INOUT) :: Target(:)
+    INTEGER :: i, j, p
+
+    IF (ElementIndex <= 0 .OR. ElementIndex > Phase24CacheCapacity) RETURN
+    IF (.NOT. ALL(Phase24PositionCache(1:N*N,ElementIndex) > 0)) RETURN
+    IF (.NOT. ALL(Phase24IndexCache(1:N,ElementIndex) == Indices(1:N))) RETURN
+    DO i=1,N
+      DO j=1,N
+        p = N*(i-1)+j
+        !$OMP ATOMIC
+        Target(Phase24PositionCache(p,ElementIndex)) = &
+             Target(Phase24PositionCache(p,ElementIndex)) + Lmtr(i,j)
+      END DO
+    END DO
+  END SUBROUTINE CRS_AddLocalMatrixCachedTo
+
