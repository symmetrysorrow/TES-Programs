+   Container->structure_epoch = structureEpochPtr ? *structureEpochPtr : Container->structure_epoch;
+   Container->matrix_epoch = matrixEpochPtr ? *matrixEpochPtr : Container->matrix_epoch;
+   Container->matrix_refresh_calls++;
