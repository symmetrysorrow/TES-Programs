+  SolveStatus = SolveHYPRE2( Matrix % NumberOfRows, Aperm, Owner, Xvec, RHSvec, &
       Rounds, TOL, verbosity, Matrix % Hypre, Matrix % Comm )
+  Phase24LinearSolveCount = Phase24LinearSolveCount + 1
+  CALL SolveHYPRE10(Matrix % Hypre, Phase24NativeAfter)
+
+  IF (ExactReuse) THEN
+    IF (Phase24NativeAfter(1) /= Phase24NativeBefore(1) .OR. &
+         Phase24NativeAfter(2) /= Phase24NativeBefore(2) .OR. &
+         Phase24NativeAfter(3) /= Phase24NativeBefore(3)) THEN
+      CALL Fatal(Caller,'Phase24 Case A native setup/matrix-refresh counter violation')
+    END IF
+  END IF
+
+  ! Recover once from a numeric-refresh convergence failure with a fresh setup,
+  ! preserving the production tolerance and iteration contract.
+  Phase24RecoveredThisSolve = .FALSE.
+  IF (SolveStatus /= 0 .AND. Phase24DiagnosticMatch) THEN
+    Phase24DiagnosticEvent = ListGetLogical(Params, &
+         'Phase24 Adaptive Event Forced',Found)
+    IF (.NOT. Found) Phase24DiagnosticEvent = .FALSE.
+    Phase24DiagnosticTrial = ListGetString(Params, &
+         'Phase24 Adaptive Trial Kind',Found)
+    IF (.NOT. Found) Phase24DiagnosticTrial = 'unknown'
+    Phase24DiagnosticUnit = 97
+    OPEN(UNIT=Phase24DiagnosticUnit, &
+         FILE=TRIM(Phase24DiagnosticPrefix)//'_x0.dat', &
+         STATUS='REPLACE',ACTION='WRITE')
+    DO i=1,SIZE(Phase24DiagnosticXBefore)
+      WRITE(Phase24DiagnosticUnit,'(I0,1X,ES24.16E3)') i, &
+           Phase24DiagnosticXBefore(i)
+    END DO
+    CLOSE(Phase24DiagnosticUnit)
+    OPEN(UNIT=Phase24DiagnosticUnit, &
+         FILE=TRIM(Phase24DiagnosticPrefix)//'_xafter.dat', &
+         STATUS='REPLACE',ACTION='WRITE')
+    DO i=1,SIZE(XVec)
+      WRITE(Phase24DiagnosticUnit,'(I0,1X,ES24.16E3)') i,XVec(i)
+    END DO
+    CLOSE(Phase24DiagnosticUnit)
+    OPEN(UNIT=Phase24DiagnosticUnit, &
+         FILE=TRIM(Phase24DiagnosticPrefix)//'_metadata.txt', &
+         STATUS='REPLACE',ACTION='WRITE')
+    WRITE(Phase24DiagnosticUnit,'(A,ES24.16E3)') 'physical_time=', &
+         Phase24DiagnosticTime
+    WRITE(Phase24DiagnosticUnit,'(A,ES24.16E3)') 'timestep=',Solver % dt
+    WRITE(Phase24DiagnosticUnit,'(A,I0)') 'bdf_order=', &
+         ListGetInteger(Params,'Phase24 Diagnostic BDF Order',Found)
+    WRITE(Phase24DiagnosticUnit,'(A,I0)') 'nonlinear_iteration=', &
+         ListGetInteger(Params,'Phase24 Diagnostic Nonlinear Iteration',Found)
+    WRITE(Phase24DiagnosticUnit,'(A,A)') 'trial_kind=',TRIM(Phase24DiagnosticTrial)
+    WRITE(Phase24DiagnosticUnit,'(A,L1)') 'event_forced=',Phase24DiagnosticEvent
+    WRITE(Phase24DiagnosticUnit,'(A,ES24.16E3)') 'event_step_start=', &
+         ListGetCReal(Params,'Phase24 Adaptive Step Start',Found)
+    WRITE(Phase24DiagnosticUnit,'(A,ES24.16E3)') 'event_step_end=', &
+         ListGetCReal(Params,'Phase24 Adaptive Step End',Found)
+    WRITE(Phase24DiagnosticUnit,'(A,ES24.16E3)') 'next_event=', &
+         ListGetCReal(Params,'Phase24 Adaptive Next Event',Found)
+    WRITE(Phase24DiagnosticUnit,'(A,I0)') 'rejection_count=', &
+         ListGetInteger(Params,'Phase24 Adaptive Rejection Count',Found)
+    WRITE(Phase24DiagnosticUnit,'(A,ES24.16E3)') 'r0=',Phase24DiagnosticR0
+    WRITE(Phase24DiagnosticUnit,'(A,I0)') 'solve_status=',SolveStatus
+    CLOSE(Phase24DiagnosticUnit)
+    CALL Info(Caller,'Phase24 HYPRE diagnostic saved x0/xafter and metadata',Level=4)
+    DEALLOCATE(Phase24DiagnosticXBefore)
+  END IF
+  IF (SolveStatus /= 0 .AND. Phase24HypreReuse) THEN
+    CALL Info(Caller,'Phase24 HYPRE solve failed; retrying with fresh setup',Level=4)
+    Phase24RecoveryCount = Phase24RecoveryCount + 1
+    Phase24RecoveredThisSolve = .TRUE.
+    CALL ListAddLogical(Params,'Phase24 HYPRE Recovery Active',.TRUE.)
+    SolveStatus = SolveHYPRE8(Matrix % Hypre, verbosity)
+    CALL SolveHYPRE9(Matrix % NumberOfRows, Aperm, Xvec, Matrix % Hypre)
+    SolveStatus = SolveHYPRE2( Matrix % NumberOfRows, Aperm, Owner, Xvec, RHSvec, &
+        Rounds, TOL, verbosity, Matrix % Hypre, Matrix % Comm )
+    Phase24LinearSolveCount = Phase24LinearSolveCount + 1
+    CALL SolveHYPRE10(Matrix % Hypre, Phase24NativeAfter)
+  END IF
+  IF (SolveStatus /= 0) THEN
+    CALL Fatal(Caller,'HYPRE failed to satisfy the production linear tolerance')
+  END IF
+
+  IF (Phase24PMR) THEN
+    Phase24PMRLastIts = Phase24NativeAfter(14)
+    IF (Phase24PMRFresh) Phase24PMRFreshIts = Phase24PMRLastIts
+    Phase24PMRFresh = .FALSE.
+    WRITE(Message,'(A,L1,A,I0,A,I0,A,I0,A,I0,A,I0)') 'Phase24 precond reuse: reused=', &
+         Phase24PMRActive .AND. Phase24PMRAge > 0, ', age=',Phase24PMRAge, &
+         ', its=',Phase24PMRLastIts,', fresh_its=',Phase24PMRFreshIts, &
+         ', rebuilds=',Phase24PMRRebuilds,', reuses=',Phase24PMRReuses
+    CALL Info(Caller,TRIM(Message),Level=4)
+  END IF
+
+  Phase24LastKrylovIterations = Phase24NativeAfter(14)
+  IF (Phase24RefreshSetup .AND. Phase24LastKrylovIterations > 0) &
+       Phase24LastFreshKrylov = Phase24LastKrylovIterations
+  IF (Phase24RefreshSetup) THEN
+    Phase24PreconditionerCooldown = 0
+    Phase24PreconditionerCooldownReason = 0
+  ELSE IF (Phase24PreconditionerReuse .AND. Phase24LastFreshKrylov > 0 .AND. &
+       REAL(Phase24LastKrylovIterations,dp) > MAX( &
+         REAL(Phase24LastFreshKrylov+8,dp), &
+         (1.0_dp+Phase24KrylovRelativeGrowth) * &
+            REAL(Phase24LastFreshKrylov,dp))) THEN
+    Phase24PreconditionerCooldown = 1
+    Phase24PreconditionerCooldownReason = 2
+    CALL Info(Caller,'Phase24 lagged AMG degradation detected; next matrix change will refresh AMG',Level=4)
+  END IF
+  IF (Phase24RecoveredThisSolve .AND. SolveStatus == 0 .AND. &
+       .NOT. Phase24RefreshSetup .AND. Phase24PreconditionerCooldown == 0) THEN
+    ! The recovery branch itself establishes a fresh setup; its native epoch
+    ! is already committed by SolveHYPRE8.  Keep one subsequent matrix change
+    ! out of the lagged-preconditioner path to avoid immediate oscillation.
+    Phase24PreconditionerCooldown = 1
+    Phase24PreconditionerCooldownReason = 3
+  END IF
+
+  CALL ListAddInteger(Params,'Phase24 HYPRE Full Rebuilds',Phase24FullSetupCount)
+  CALL ListAddInteger(Params,'Phase24 HYPRE Case A Reuses',Phase24CaseACount)
+  CALL ListAddInteger(Params,'Phase24 HYPRE Case B Refreshes',Phase24CaseBCount)
+  CALL ListAddInteger(Params,'Phase24 HYPRE AMG Setups',Phase24AMGSetupCount)
+  CALL ListAddInteger(Params,'Phase24 HYPRE Linear Solves',Phase24LinearSolveCount)
+  CALL ListAddInteger(Params,'Phase24 HYPRE Recovery Events',Phase24RecoveryCount)
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native Matrix Refreshes',Phase24NativeAfter(1))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native Krylov Setups',Phase24NativeAfter(2))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native AMG Setups',Phase24NativeAfter(3))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native Solves',Phase24NativeAfter(4))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native Case A Direct Solves',Phase24NativeAfter(5))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native Recovery Setups',Phase24NativeAfter(6))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Native Last Krylov Iterations',Phase24NativeAfter(14))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Case B Reused AMG',Phase24NativeAfter(15))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Case B Fresh AMG',Phase24NativeAfter(16))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Age Rebuilds',Phase24NativeAfter(17))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Degradation Rebuilds',Phase24NativeAfter(18))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Recovery Rebuilds',Phase24NativeAfter(19))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Current Matrix Epoch',Phase24NativeAfter(20))
+  CALL ListAddInteger(Params,'Phase24 HYPRE Preconditioner Epoch',Phase24NativeAfter(21))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU Backend Active',Phase24NativeAfter(22))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU Matrix H2D Refreshes',Phase24NativeAfter(23))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU RHS H2D Transfers',Phase24NativeAfter(24))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU Solution H2D Transfers',Phase24NativeAfter(25))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU Solution D2H Syncs',Phase24NativeAfter(26))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU Full Object Migrations',Phase24NativeAfter(27))
+  CALL ListAddInteger(Params,'Phase24 HYPRE GPU Device Allocation Events',Phase24NativeAfter(28))
+  IF (Phase24HypreReuse .AND. Phase24EpochsFound) THEN
+    WRITE(Message,'(A,6(I0,1X))') 'Phase24 HYPRE counters: full caseA caseB amg solves recovery=', &
+         Phase24FullSetupCount,Phase24CaseACount,Phase24CaseBCount, &
+         Phase24AMGSetupCount,Phase24LinearSolveCount,Phase24RecoveryCount
+    CALL Info(Caller,TRIM(Message),Level=4)
+    WRITE(Message,'(A,7(I0,1X))') 'Phase24 native counters: refresh krylov_setup amg_setup solves caseA recovery_setup last_iters=', &
+         Phase24NativeAfter(1),Phase24NativeAfter(2),Phase24NativeAfter(3), &
+         Phase24NativeAfter(4),Phase24NativeAfter(5),Phase24NativeAfter(6), &
+         Phase24NativeAfter(14)
+    CALL Info(Caller,TRIM(Message),Level=4)
+    WRITE(Message,'(A,8(I0,1X))') 'Phase24 preconditioner counters: B_reused B_fresh age degradation recovery matrix_epoch preconditioner_epoch cooldown=', &
+         Phase24NativeAfter(15),Phase24NativeAfter(16),Phase24NativeAfter(17), &
